          "你正在學習把『照顧自己』從奢侈品變成日常必需品。"
        ],
        future: [
          "未來的你會更懂得分辨哪些事值得消耗情緒，哪些可以放下。",
          "如果你願意從今天開始多聽一點身體的聲音，未來的你會比較輕鬆。",
          "有一天你會回頭謝謝現在的自己，因為你願意承認『我真的累了』，並且做出改變。"
        ]
      },
      other: {
        horoscopeVibes: [
          "今天的主題是：在混亂裡找到一個可以暫時喘息的小角落。",
          "今天適合先照顧好自己的身體，再談理想與計畫。",
          "今天的你不一定狀態完美，但某種不完美剛好讓你更接近真實的自己。"
        ],
        smallTips: [
          "試著在行程中空出 10 分鐘，只做一件完全跟效率無關的小事。",
          "如果事情很多，先寫下三件『不做也不會世界毀滅』的事，暫時從待辦清單刪掉。",
          "允許自己有一點點廢，一點點就好，不需要拿今天的自己和巔峰狀態比較。"
        ],
        reminderCards: [
          {
            title: "卡片：你已經做得很好了",
            body: "也許你覺得自己還不夠，但你已經在現有條件下盡力了。請給自己一點時間，讓成果慢慢長出來。"
          },
          {
            title: "卡片：可以改問別的問題",
            body: "如果『我到底行不行』這個問題太折磨人，不妨改問：『我現在能為自己做的下一個小決定是什麼？』"
          },
          {
            title: "卡片：慢慢來也沒關係",
            body: "你的人生不是跟別人比賽。只要方向大致是你想去的地方，就算走得慢也很值得。"
          }
        ],
        past: [
          "過去的你用很多方式在嘗試生存，有時候是努力，有時候是裝作沒事。",
          "你花了很多力氣在滿足別人的期待，才慢慢開始問自己真正想要什麼。",
          "你走過一些別人不一定懂的辛苦，所以現在的你更加敏感而溫柔。"
        ],
        present: [
          "現在的你同時在處理外在的事情和內在的情緒，像是在雙線作戰。",
          "你可能覺得自己很矛盾，但其實那只是不同的需求在說話。",
          "你正在學習用更溫柔的方式對待自己，不再只靠批評來推動前進。"
        ],
        future: [
          "未來的你會更清楚自己在乎的是什麼，也會更敢說出來。",
          "如果你願意持續為自己做一點點選擇，生活會慢慢變成比較像你的樣子。",
          "有一天你會發現，現在覺得很迷惘的這一段，其實是之後故事裡很重要的一章。"
        ]
      }
    };

    function pickRandom(arr) {
      return arr[Math.floor(Math.random() * arr.length)];
    }

    // 把使用者 note 做成清楚的一段輸出
    function getUserNoteText(note) {
      if (!note.trim()) return "";
      return `
────────────────────────
🪐 你對宇宙悄悄補充的小事：

「${note.trim()}」

宇宙已經收到這份背景訊息，會一起放進今日的解讀中。
────────────────────────
`;
    }

    // ---- 主題偵測邏輯（C 方案：自動＋可覆蓋）----
    let currentTopic = "other";
    let topicOverride = null; // 使用者有沒有手動選

    function detectTopicFromNote(note) {
      const n = note.trim();
      if (!n) return "other";

      const loveKeywords = ["喜歡", "曖昧", "戀愛", "感情", "在一起", "分手", "告白", "心動", "男友", "女友"];
      const workKeywords = ["工作", "上班", "職場", "公司", "老闆", "主管", "面試", "加班"];
      const studyKeywords = ["報告", "作業", "功課", "考試", "學校", "期中", "期末", "論文"];
      const healKeywords = ["心累", "焦慮", "憂鬱", "想哭", "崩潰", "壓力", "好累", "疲憊", "不想動"];

      const check = (list) => list.some(k => n.includes(k));

      if (check(loveKeywords)) return "love";
      if (check(workKeywords)) return "work";
      if (check(studyKeywords)) return "study";
      if (check(healKeywords)) return "heal";
      return "other";
    }

    function updateTopicUI(topic, fromUser) {
      currentTopic = topic;
      if (fromUser) {
        topicOverride = topic;
      }
      const label = topicLabels[topic] || topicLabels.other;
      const topicText = document.getElementById("topicText");
      topicText.textContent = `目前主題：${label}（${fromUser ? "手動選擇" : "系統判定，可上面調整"}）`;

      document.querySelectorAll(".topic-btn").forEach(btn => {
        btn.classList.toggle("topic-active", btn.dataset.topic === topic);
      });
    }

    function autoDetectTopic() {
      if (topicOverride) return; // 使用者已經手動選，就不要再亂改
      const note = document.getElementById("note").value;
      const detected = detectTopicFromNote(note);
      updateTopicUI(detected, false);
    }

    // ---- 綁定事件 ----
    // 初始化主題 UI
    updateTopicUI("other", false);

    // note 改變時，自動偵測主題
    document.getElementById("note").addEventListener("input", () => {
      topicOverride = null; // 重新輸入就讓系統重新判斷
      autoDetectTopic();
    });

    // 主題按鈕：手動覆蓋
    document.querySelectorAll(".topic-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        const t = btn.dataset.topic;
        updateTopicUI(t, true);
      });
    });

    function getConfigForCurrentTopic() {
      return topicConfigs[currentTopic] || topicConfigs.other;
    }

    // ---- 三種抽法 ----
    // 今日占星運勢
    document.getElementById("btnHoroscope").addEventListener("click", () => {
      const sign = document.getElementById("sign").value;
      const note = document.getElementById("note").value;
      autoDetectTopic(); // 再確認一次主題
      const cfg = getConfigForCurrentTopic();

      const tone = signTones[sign] || "";
      const vibe = pickRandom(cfg.horoscopeVibes);
      const tip = pickRandom(cfg.smallTips);
      const noteText = getUserNoteText(note);
      const topicLabel = topicLabels[currentTopic] || topicLabels.other;

      const text =
`【${sign}｜今日占星運勢｜主題：${topicLabel}】

${tone}

宇宙的今日主題：
${vibe}

${noteText}
給你的實用小提醒：
${tip}

※ 請把這個結果當成一個小小觀察視角，而不是命令。`;

      document.getElementById("result").textContent = text;
    });

    // 單張今日提醒卡
    document.getElementById("btnSingleCard").addEventListener("click", () => {
      const sign = document.getElementById("sign").value;
      const note = document.getElementById("note").value;
      autoDetectTopic();
      const cfg = getConfigForCurrentTopic();
      const topicLabel = topicLabels[currentTopic] || topicLabels.other;

      const card = pickRandom(cfg.reminderCards);
      const noteText = getUserNoteText(note);

      const text =
`【${sign} 的今日提醒卡｜主題：${topicLabel}】

${card.title}
${card.body}

${noteText}
可以把這張卡截圖存起來，當成今天的背景程式。`;

      document.getElementById("result").textContent = text;
    });

    // 三張牌：過去 / 現在 / 未來
    document.getElementById("btnThreeCards").addEventListener("click", () => {
      const sign = document.getElementById("sign").value;
      const note = document.getElementById("note").value;
      autoDetectTopic();
      const cfg = getConfigForCurrentTopic();
      const topicLabel = topicLabels[currentTopic] || topicLabels.other;

      const past = pickRandom(cfg.past);
      const present = pickRandom(cfg.present);
      const future = pickRandom(cfg.future);
      const noteText = getUserNoteText(note);

      const text =
`【${sign}｜三張牌占卜：過去・現在・未來｜主題：${topicLabel}】

🕰 過去：
${past}

📍 現在：
${present}

🌱 未來：
${future}

${noteText}
抽牌不是要你照著做，而是幫你整理、命名你已經感覺到的東西。`;

      document.getElementById("result").textContent = text;
    });
  </script>
</body>
</html>
